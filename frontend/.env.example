# Base URL of the Bridge API. REACT_APP_BACKEND_URL is also accepted.
VITE_BACKEND_URL=http://localhost:8000

# Optional: ICE servers as a JSON array of RTCIceServer. STUN alone fails behind
# symmetric NATs and strict firewalls; add a TURN relay for those networks.
# Replaces the default Google STUN servers, so keep a STUN entry in the list.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
