# Base URL of the Bridge API. REACT_APP_BACKEND_URL is also accepted.
VITE_BACKEND_URL=http://localhost:8000

# Optional: extra ICE servers (TURN relay) as a JSON array of RTCIceServer.
#
# STUN alone fails behind symmetric NATs, carrier-grade NAT (many mobile
# networks) and strict firewalls; a TURN relay lets those calls connect.
# Paste your provider's complete ICE servers array here, e.g. Metered's
# "ICE Servers Array" for a TURN credential. Entries are ADDED to the default
# Google STUN servers, which are always kept.
#
# Format rules:
# - Strict JSON on one line: double-quoted keys and strings, no trailing commas.
#   (Metered's dashboard shows JavaScript syntax, `urls: "..."`; quote the keys.)
# - Every entry needs "urls" (a string or an array) using stun:, turn: or turns:.
# - turn:/turns: entries also need "username" and "credential".
# - Invalid entries are skipped with a console warning; invalid JSON falls back
#   to STUN only, so a bad value degrades calls but never breaks them.
#
# Read at BUILD time and embedded in the public JavaScript bundle, so anyone can
# read it. Only use a TURN credential here (per-credential username/password,
# revocable, ideally with a usage limit or expiry), never the provider's
# account-wide Secret Key or API key. Rebuild after changing it.
#
# VITE_ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"<turn-username>","credential":"<turn-credential>"},{"urls":"turn:global.relay.metered.ca:80?transport=tcp","username":"<turn-username>","credential":"<turn-credential>"},{"urls":"turn:global.relay.metered.ca:443","username":"<turn-username>","credential":"<turn-credential>"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"<turn-username>","credential":"<turn-credential>"}]
